PROJECT_NAME="AI First Template Symphony"
# Linear project slug that Symphony polls for eligible issues.
LINEAR_PROJECT_SLUG=aifirst-template
TARGET_REPO_NAME=aifirst-template
TARGET_REPO_URL=https://github.com/your-org/aifirst-template.git
TARGET_REPO_BASE_BRANCH=template
# Linear label used to keep this runner focused on this repository/profile.
TRACKER_LABEL=aifirst-template
OPENCODE_REVIEW_REQUIRED=true
OPENCODE_COMMAND=opencode
OPENCODE_REVIEW_TIMEOUT_SECONDS=180
EXTERNAL_CODE_REVIEW_REQUIRED=false
# Comma-separated GitHub check/status names, for example:
# EXTERNAL_CODE_REVIEW_CHECKS="CodeRabbit"
EXTERNAL_CODE_REVIEW_CHECKS=
HUMAN_APPROVAL_PHRASE="Human Approval: merge approved"
SERVER_PORT=4012
