# Optional runtime override. Leave empty to use runtime.lock + bootstrap cache.
SYMPHONY_ELIXIR_ROOT=
# Linear personal API key with permission to read and update the target project.
LINEAR_API_KEY=lin_api_replace_me
GH_TOKEN=
SERVER_PORT=4012
MAX_CONCURRENT_AGENTS=1
MAX_TURNS=40
CODEX_COMMAND="codex app-server"
OPENCODE_COMMAND=opencode
OPENCODE_REVIEW_TIMEOUT_SECONDS=180
WORKSPACE_ROOT=/absolute/path/to/aifirst-template-symphony/workspaces
SYMPHONY_PROFILE=aifirst-template
